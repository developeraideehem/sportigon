# Supabase Configuration
# Get these values from your Supabase project dashboard: https://app.supabase.com

# Your Supabase project URL
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anon/public key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API-Football Configuration (api-sports.io)
# Sign up at: https://dashboard.api-football.com/register
# Free tier: 100 requests/day
VITE_API_FOOTBALL_KEY=your_api_football_key_here
VITE_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
VITE_API_BASKETBALL_BASE_URL=https://v1.basketball.api-sports.io
VITE_API_BASEBALL_BASE_URL=https://v1.baseball.api-sports.io

# Feature Flags (comma-separated list)
# Available flags: live-scores-api, ai-predictions, premium-features, beta-ui, social-sharing, push-notifications
VITE_ENABLED_FEATURES=live-scores-api

# Environment (development | staging | production)
VITE_ENVIRONMENT=development

